{
  "name": "agent-bridge-service",
  "version": "0.1.0",
  "description": "Bridge the AI coding CLIs installed on your machine to a remote orchestration platform over an outbound WebSocket",
  "type": "module",
  "bin": {
    "agent-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "start": "npm run build && node dist/cli.js",
    "prepublishOnly": "npm run build",
    "gate": "bash .harness/hooks/post-change-gate.sh",
    "arch:check": "node .harness/scripts/protocol-boundary-check.mjs",
    "doc:check": "node .harness/scripts/doc-contract-check.mjs",
    "harness:validate": "bash .harness/scripts/harness-validate.sh",
    "openspec:validate": "bash .harness/skills/openspec-workflow/scripts/validate-change.sh",
    "e2e:smoke": "node .harness/skills/protocol-e2e/scripts/e2e-smoke.mjs"
  },
  "keywords": [
    "ai",
    "cli",
    "agent",
    "bridge",
    "websocket",
    "devtools",
    "claude-code",
    "codex",
    "automation"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "smol-toml": "^1.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaylanwu/agent-bridge.git"
  },
  "homepage": "https://github.com/shaylanwu/agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/shaylanwu/agent-bridge/issues"
  }
}
