{
  "name": "agent-bridge-service",
  "version": "0.2.1",
  "description": "Give a remote platform control of the AI agents installed on your machine, over an outbound WebSocket",
  "type": "module",
  "bin": {
    "agent-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "start": "npm run build && node dist/cli.js",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "gate": "bash .harness/hooks/post-change-gate.sh",
    "arch:check": "node .harness/scripts/protocol-boundary-check.mjs",
    "doc:check": "node .harness/scripts/doc-contract-check.mjs",
    "harness:validate": "bash .harness/scripts/harness-validate.sh",
    "contracts:check": "node scripts/gen-contracts.mjs --check",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "site:check": "npm --prefix site run check",
    "openspec:validate": "bash .harness/skills/openspec-workflow/scripts/validate-change.sh",
    "e2e:smoke": "node .harness/skills/protocol-e2e/scripts/e2e-smoke.mjs"
  },
  "keywords": [
    "ai",
    "cli",
    "agent",
    "bridge",
    "websocket",
    "devtools",
    "claude-code",
    "codex",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "smol-toml": "^1.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaylanwu/agent-bridge.git"
  },
  "homepage": "https://shaylanwu.github.io/agent-bridge/",
  "bugs": {
    "url": "https://github.com/shaylanwu/agent-bridge/issues"
  }
}
